# 本地环境变量示例（复制为 .env 后填入真实值，.env 不提交版本库）
# 数据库连接地址：必须带库名 pilipili，否则连接池中未执行 USE 的连接会报 1046 No database selected。
# 全新环境需先用任意 MySQL 客户端执行一次 CREATE DATABASE IF NOT EXISTS pilipili;（见 README 第 0 步），
# 启动后由 schema.sql / data.sql 自动建表灌种子（幂等）。
PILIPILI_DB_URL=jdbc:mysql://localhost:3306/pilipili?useUnicode=true&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai&allowMultiQueries=true
PILIPILI_DB_USER=root
# 必填，请勿把真实密码写进代码库
PILIPILI_DB_PASSWORD=CHANGE_ME
PILIPILI_PORT=9090
PILIPILI_CORS_ORIGINS=http://localhost:8787,http://localhost:8788,http://localhost:5173
PILIPILI_JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
